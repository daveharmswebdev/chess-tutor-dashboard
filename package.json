{
  "name": "chess-tutor-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "typecheck": "tsc --noEmit && tsc -p .claude/hooks --noEmit",
    "test": "vitest run",
    "demo": "gh workflow run demo.yml && sleep 8 && gh run watch \"$(gh run list --workflow demo.yml --event workflow_dispatch --limit 1 --json databaseId --jq \".[0].databaseId\")\" --exit-status"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.3.1",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
